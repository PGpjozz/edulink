# Copy to .env.local and fill in values from Neon dashboard (Connect)

NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32
NEXTAUTH_URL=http://localhost:3000

# Pooled connection (hostname includes -pooler)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct connection (no -pooler) — required for prisma db push / migrate / seed
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Optional: Resend (https://resend.com) for invite & password-reset emails
RESEND_API_KEY=
EMAIL_FROM=EduLink <noreply@yourdomain.com>

# PayFast (https://payfast.co.za) — sandbox for testing
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
