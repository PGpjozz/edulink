# Copy to .env.local and fill in values

# ─── Required ───────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32
NEXTAUTH_URL=http://localhost:3000

# Pooled connection (hostname includes -pooler)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct connection (no -pooler) — required for prisma db push / migrate / seed
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ─── Email (required in production) ───────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=EduLink <noreply@yourdomain.com>

# ─── PayFast (required in production for real payments) ───────────────────
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# ─── Development only — NEVER set in production ───────────────────────────
# ENABLE_DEV_ROUTES=true          # Enables /api/setup and /api/seed
# ALLOW_PAYMENT_SIMULATION=false  # Disable PayFast simulation in dev
